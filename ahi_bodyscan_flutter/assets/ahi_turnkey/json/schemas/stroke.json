{
    "schema": "http://json-schema.org/draft-07/schema#",
    "type": "array",
    "description": "Schema for Stroke Risk https://app.clickup.com/t/865c6egvz.",
    "items":
    {
        "description": "array of cutoffs values.",
        "type": "object",
        "properties":
        {
            "risk":
            {
                "type": "string",
                "description": "Risk value",
                "enum": ["low", "lowMedium", "medium", "high", "veryHigh"]
            },
            "lowerBound":
            {
                "type": "number",
                "description": "cutoff lower bound value, if not included = 0"
            },
            "upperBound":
            {
                "type": "number",
                "description": "cutoff upper bound value, if not included = 99999"
            }
        },
        "required": ["risk"]
    }
}