# AHI BodyScan Flutter - Environment Configuration
# Copy this file to .env and fill in your actual credentials
# NEVER commit the .env file to version control!

# AHI SDK Configuration
AHI_SDK_TOKEN=your-ahi-sdk-token-here

# Vastmindz SDK Configuration
VASTMINDZ_WEBSOCKET_URL=wss://vm-production.xyz/vp/bgr_signal_socket
VASTMINDZ_AUTH_TOKEN=your-vastmindz-token-here

# AWS S3 Maven Credentials (for AHI SDK)
# These should be set in android/gradle.properties (NOT committed to git)
# ahiMavenAccessKey=your-access-key
# ahiMavenSecretKey=your-secret-key

# Environment
ENVIRONMENT=development
