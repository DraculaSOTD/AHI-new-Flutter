{
    "schema": "http://json-schema.org/draft-07/schema#",
    "type": "array",
    "description": "Schema for breathing rate risk https://docs.advancedhumanimaging.com/breathing-rate.",
    "items":
    {
        "description": "array of cutoffs values.",
        "type": "object",
        "properties":
        {
            "risk":
            {
                "type": "string",
                "description": "risk value for the cutoff",
                "enum": ["low", "normal", "high"]
            },
            "lowerBound":
            {
                "type": "number",
                "description": "cutoff lower bound value, if not included = 0"
            },
            "upperBound":
            {
                "type": "number",
                "description": "cutoff upper bound value, if not included = 99999"
            }
        },
        "required": ["risk"]
    }
}