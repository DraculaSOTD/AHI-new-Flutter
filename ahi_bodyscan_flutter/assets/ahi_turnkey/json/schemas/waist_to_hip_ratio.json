{
    "schema": "http://json-schema.org/draft-07/schema#",
    "type": "array",
    "description": "Schema for Waist-to-Hip Ratio (RAG) https://app.clickup.com/t/865c6f55h.",
    "items":
    {
        "description": "array of for each biological sex.",
        "type": "object",
        "properties":
        {
            "biologicalSex":
            {
                "type": "string",
                "description": "biological Sex",
                "enum": ["female", "male"]
            },
            "risks":
            {
                "type": "array",
                "items":
                {
                    "description": "array of body fat percentage risk cutoffs values.",
                    "type": "object",
                    "properties":
                    {
                        "risk":
                        {
                            "type": "string",
                            "description": "central obesity Risk",
                            "enum": ["R", "A", "G"]
                        },
                        "lowerBound":
                        {
                            "type": "number",
                            "description": "cutoff lower bound value, if not included = 0"
                        },
                        "upperBound":
                        {
                            "type": "number",
                            "description": "cutoff upper bound value, if not included = 99999"
                        }
                    },
                    "required": ["risk"]
                }
            }
        },
        "required": ["biologicalSex", "risks"]
    }
}